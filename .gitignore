# ============================================================================
# CloudATS — .gitignore
# ============================================================================

# ── Java / Maven ──────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar

# ── IDE ───────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
dist/
.env
.env.local
.env.*.local
*.tsbuildinfo

# ── Docker ────────────────────────────────────────────────────
# Don't ignore docker-compose.yml or Dockerfiles
*.pid

# ── Kubernetes ────────────────────────────────────────────────
# Don't commit generated secrets
k8s/**/secrets-generated.yaml

# ── Monitoring ────────────────────────────────────────────────
# Prometheus/Grafana data volumes
monitoring/prometheus/data/
monitoring/grafana/data/

# ── Misc ──────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
logs/
